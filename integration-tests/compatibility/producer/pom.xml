<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.store</groupId>
        <artifactId>integration-tests</artifactId>
        <version>5.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>integration-tests-compatibility-producer</artifactId>
    <name>EclipseStore Integration Tests - Compatibility - Producer</name>
    <url>https://projects.eclipse.org/projects/technology.store</url>

    <!--
        Writes one storage per TypeEnum entry with a RELEASED Eclipse Store version (compatibility.producer.version) into compatibility.storage.dir. The consumer module then opens those storages with the current snapshot. Run the producer and the consumer in separate Maven invocations when the JDK should differ between them.
    -->
    <dependencies>
        <!-- The released Eclipse Store version that writes the storage; overridden per matrix leg. -->
        <dependency>
            <groupId>org.eclipse.store</groupId>
            <artifactId>storage-embedded</artifactId>
            <version>${compatibility.producer.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.store</groupId>
            <artifactId>integration-tests-fixtures-types-library</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <properties>
        <!-- Shared between producer and consumer: the directory with one storage per TypeEnum entry. -->
        <compatibility.storage.dir>${project.basedir}/../target/storage</compatibility.storage.dir>
        <!-- Newest release by default; the CI matrix passes every minor line read from Maven Central. -->
        <compatibility.producer.version>4.2.0</compatibility.producer.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <compatibility.storage.dir>${compatibility.storage.dir}</compatibility.storage.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
