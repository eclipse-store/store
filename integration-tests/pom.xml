<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.store</groupId>
        <artifactId>store-parent</artifactId>
        <version>5.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>integration-tests</artifactId>
    <packaging>pom</packaging>
    <name>EclipseStore Integration Tests</name>
    <url>https://projects.eclipse.org/projects/technology.store</url>

    <!--
        Aggregator of every integration test suite. Only built with the IT profile of the root pom.
        Nothing below is deployed or published; the modules exist to be executed in CI.
    -->
    <modules>
        <module>fixtures/types-library</module>
        <module>fixtures/legacy-a</module>
        <module>fixtures/legacy-b</module>
        <module>core</module>
        <module>jdk/records</module>
        <module>jdk/sealed</module>
        <module>jdk/immutable-collections</module>
        <module>jdk/kotlin</module>
        <module>skills/cache-jcache</module>
        <module>skills/concurrency</module>
        <module>skills/configuration</module>
        <module>skills/custom-type-handlers</module>
        <module>skills/getting-started</module>
        <module>skills/housekeeping</module>
        <module>skills/lazy-loading</module>
        <module>skills/legacy-type-mapping</module>
        <module>skills/root-and-object-graph</module>
        <module>skills/serializer-standalone</module>
        <module>skills/spring-boot</module>
        <module>skills/storage-targets-afs</module>
        <module>skills/storing-data</module>
        <module>afs</module>
        <module>cache/spring-hibernate</module>
        <module>cache/jcache-tck</module>
        <module>cache/jcache-tck-annotations-cdi</module>
        <module>cache/jcache-tck-annotations-spring</module>
        <module>cache/jcache-tck-annotations-guice</module>
        <module>compatibility/producer</module>
        <module>compatibility/consumer</module>
        <module>ui</module>
        <module>communication-legacy/host</module>
        <module>communication-legacy/client</module>
    </modules>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <junit-jupiter.version>6.0.3</junit-jupiter.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- Extra JVM args for the test fork; JDK-specific values are set by the profiles below. -->
        <extra.jvm.args></extra.jvm.args>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Explicit overrides: store-parent pins these to 5.8.2; an imported BOM cannot
                 override a version inherited from the parent, so they must be set directly. -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <trimStackTrace>false</trimStackTrace>
                    <argLine>
                        ${extra.jvm.args}
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.lang.ref=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens java.base/java.net=ALL-UNNAMED
                        --add-opens java.base/java.time=ALL-UNNAMED
                        --add-opens java.base/java.time.zone=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.util.concurrent=ALL-UNNAMED
                        --add-opens java.base/java.util.concurrent.atomic=ALL-UNNAMED
                        --add-opens java.base/java.util.concurrent.locks=ALL-UNNAMED
                        --add-opens java.base/java.util.regex=ALL-UNNAMED
                        --add-opens java.base/sun.net.www.protocol.http=ALL-UNNAMED
                        --add-opens java.base/sun.nio.fs=ALL-UNNAMED
                        --add-opens java.base/sun.util.calendar=ALL-UNNAMED
                        --add-exports java.base/jdk.internal.misc=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jdk21-plus</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <modules>
                <module>jdk/sequenced</module>
            </modules>
        </profile>
        <profile>
            <id>jdk22-plus</id>
            <activation>
                <jdk>[22,)</jdk>
            </activation>
            <modules>
                <!-- needs gigamap-jvector, which the gigamap reactor only builds on JDK 22+ -->
                <module>skills/gigamap</module>
            </modules>
        </profile>
        <profile>
            <!--
                JDK 25+ can run with compact object headers (JEP 519). The serializer accesses object
                headers directly, so every test fork pins the layout the serializer was built for.
                The CI matrix has a dedicated leg that re-enables the flag to detect when that changes.
            -->
            <id>jdk25-plus</id>
            <activation>
                <jdk>[25,)</jdk>
            </activation>
            <properties>
                <extra.jvm.args>-XX:-UseCompactObjectHeaders</extra.jvm.args>
            </properties>
        </profile>
    </profiles>

</project>
