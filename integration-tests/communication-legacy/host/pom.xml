<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.store</groupId>
        <artifactId>integration-tests</artifactId>
        <version>5.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>integration-tests-communication-legacy-host</artifactId>
    <name>EclipseStore Integration Tests - Communication Legacy - Host</name>
    <url>https://projects.eclipse.org/projects/technology.store</url>

    <!--
        Host side of the legacy type mapping test over the serializer communication layer, compiled against the legacy-a shapes of the sample classes. Started in a separate JVM by the client module (HostMain).
    -->
    <dependencies>
        <dependency>
            <groupId>org.eclipse.store</groupId>
            <artifactId>integration-tests-fixtures-legacy-a</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.store</groupId>
            <artifactId>storage-embedded</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.serializer</groupId>
            <artifactId>communication-binary</artifactId>
            <version>${eclipse.serializer.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.serializer</groupId>
            <artifactId>communication</artifactId>
            <version>${eclipse.serializer.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <properties>
        <!-- The host tests block until a client connects; they are only ever started by the client module
             in a second JVM, never by surefire. Compile them, do not run them. -->
        <skipTests>true</skipTests>
    </properties>

    <build>
        <plugins>
            <!-- Class path of the host JVM that the client module launches (see AbstractCommunicationTest). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>host-classpath</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>test</includeScope>
                            <outputFile>${project.build.directory}/host-classpath.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
